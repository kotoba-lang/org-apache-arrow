{:paths ["src"]
 ;; columnar and nothing else. It carries both halves of the seam this library
 ;; plugs into -- `IColumnSource` (what the engine asks a format for) and
 ;; `IByteSource` (what a format asks the world for) -- and is itself zero-dep
 ;; portable .cljc, so the transitive cost is nil.
 :deps {io.github.kotoba-lang/columnar
        {:git/url "https://github.com/kotoba-lang/columnar.git"
         :git/sha "16b336b1040098d15b55cf63ae7bf8efca6aedda"}
        ;; ZSTD body compression. Same zero-dep portable .cljc decoder
        ;; org-apache-parquet uses, for the same reason: a native binding
        ;; exists on exactly one of the runtimes this reader must keep
        ;; running on.
        io.github.kotoba-lang/org-ietf-zstd
        {:git/url "https://github.com/kotoba-lang/org-ietf-zstd.git"
         :git/sha "5362525f26e1dd7646cf917e9b485df2028c3967"}}
 :aliases
 ;; kotobase-lake is a TEST dependency only. This repo provides a column source
 ;; and must not know about catalogs, tenants or triple patterns — but the
 ;; claim this repo exists to check is that the lake's scan seam takes a
 ;; SECOND format without changing, and only an end-to-end test against a real
 ;; file can say so.
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      io.github.kotoba-lang/kotobase-lake
                      {:git/url "https://github.com/kotoba-lang/kotobase-lake.git"
                       :git/sha "06d658a08a898d6e7efced696ebd7b74a7a9be0d"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; The same portable suite under real ClojureScript. Not a duplicate of the
  ;; JVM run: `arrow.flatbuffers/i64` has a reader conditional per platform,
  ;; and refusing a value past 2^53 rather than rounding it is a claim that
  ;; only the cljs run can check.
  :cljs {:extra-paths ["test"]
         :extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}}}
  ;; Writes the files `test/fixtures/verify_written.py` hands to pyarrow. A
  ;; separate entrypoint because the claim it supports -- that a file we wrote
  ;; is a file a REAL Arrow implementation accepts -- cannot be checked from
  ;; inside this repo: a self-round-trip only proves the writer and the reader
  ;; share an opinion, and the failures that matter most are exactly the ones
  ;; both halves would share.
  :emit {:extra-paths ["test"]
         :main-opts ["-m" "arrow.emit-for-python"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
